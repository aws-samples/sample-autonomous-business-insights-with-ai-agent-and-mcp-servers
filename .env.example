# ============================================================
# IMPORTANT: Security Notice
# ============================================================
# This .env file is suitable for LOCAL DEVELOPMENT ONLY.
# For production deployments:
#   - Use AWS Secrets Manager to store sensitive credentials
#   - Reference secrets via IAM roles, not environment variables
#   - Never commit .env files to version control
#   - Use AWS Systems Manager Parameter Store for configuration
#
# See: https://docs.aws.amazon.com/secretsmanager/latest/userguide/
# ============================================================

# ============================================================
# Core Configuration
# ============================================================

# AWS Region
AWS_REGION=us-east-1

# Amazon Bedrock Model
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# Simulation Mode: controls whether the agent uses the AgentCore Gateway
# or local MCP servers with a local policy hook.
#   "false" (default) — Agent connects to AgentCore Gateway (production path)
#   "true"            — Agent uses local MCP servers + local policy hook (dev fallback)
# For local demo without deploying a Gateway, set this to true.
SIMULATION_MODE=true

# Data Mode: controls where local MCP servers fetch data from.
# Only relevant when SIMULATION_MODE=true (local MCP servers).
#   "simulated" — In-memory sample data (default, no AWS infra needed)
#   "live"      — Real AWS services (requires credentials below)
# When using AgentCore Gateway (SIMULATION_MODE=false, the default),
# this setting is ignored — Lambda targets handle data retrieval.
DATA_MODE=simulated

# MCP Server Mode: "false" (all custom local) or "true" (pre-built AWS + custom)
# When true, uses awslabs.postgres-mcp-server and awslabs.redshift-mcp-server
# via uvx (requires uv installed: https://docs.astral.sh/uv/)
USE_PREBUILT_MCP=false

# ============================================================
# MCP Server Ports (local development)
# ============================================================
SEMANTIC_LAYER_SERVER_PORT=8005
EQUIPMENT_SERVER_PORT=8001
IOT_TELEMETRY_SERVER_PORT=8002
SUPPLY_CHAIN_SERVER_PORT=8003
ANALYTICS_SERVER_PORT=8004

# ============================================================
# Live Mode — Data Infrastructure
# ============================================================
# Only needed when DATA_MODE=live AND SIMULATION_MODE=true.
# Get these values from CloudFormation stack outputs after deployment:
#   aws cloudformation describe-stacks --stack-name manufacturing-insights-dev \
#     --query "Stacks[0].Outputs" --output table
# ============================================================

# Amazon Aurora PostgreSQL (Equipment + Maintenance)
AURORA_CLUSTER_ARN=arn:aws:rds:us-east-1:<YOUR_AWS_ACCOUNT_ID>:cluster:manufacturing-equipment-dev
AURORA_SECRET_ARN=arn:aws:secretsmanager:us-east-1:<YOUR_AWS_ACCOUNT_ID>:secret:manufacturing-aurora-credentials-dev-AbCdEf
AURORA_DATABASE=manufacturing

# Amazon Timestream (IoT Sensor Telemetry)
TIMESTREAM_DATABASE=manufacturing_iot_dev
TIMESTREAM_TABLE=sensor_readings

# Amazon Redshift Serverless (Supply Chain + Analytics)
REDSHIFT_WORKGROUP=manufacturing-analytics-dev
REDSHIFT_DATABASE=manufacturing

# Amazon OpenSearch Serverless (Quality Metrics)
OPENSEARCH_ENDPOINT=https://abc123def456.us-east-1.aoss.amazonaws.com
OPENSEARCH_INDEX=quality_metrics

# Amazon S3 (Data Lake + Configuration)
DATA_LAKE_BUCKET=amzn-s3-demo-manufacturing-datalake-<YOUR_AWS_ACCOUNT_ID>-dev

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO

# ============================================================
# Demo User Passwords (required for deploy/agentcore/ scripts)
# Create your own passwords — must meet Cognito policy:
#   8+ characters, uppercase, lowercase, number, symbol
# ============================================================
# DEMO_PASSWORD_SARAH=
# DEMO_PASSWORD_RAJ=
# DEMO_PASSWORD_PRIYA=

# ============================================================
# Budget / Cost Management (DynamoDB)
# ============================================================
# Table for per-user daily token counters (created by CFN or setup_budgets.py)
BUDGET_TABLE_NAME=MfgInsights-BudgetCounters
